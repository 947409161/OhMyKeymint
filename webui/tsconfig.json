{
	"compilerOptions": {
		"target": "es2022",
		"module": "esnext",
		"lib": [
			"ES2023",
			"DOM",
			"DOM.Iterable"
		],
		"types": [
			"vite/client",
			"node"
		],
		"jsx": "react-jsx",
		"moduleResolution": "bundler",
		"verbatimModuleSyntax": true,
		"moduleDetection": "force",
		"allowImportingTsExtensions": true,
		"noEmit": true,
		"skipLibCheck": true,
		"strict": true,
		"noUnusedLocals": true,
		"noUnusedParameters": true,
		"noFallthroughCasesInSwitch": true,
		"paths": {
			"@/*": [
				"./src/*"
			],
			"@components/*": [
				"./src/components/*"
			],
			"@bridge/*": [
				"./src/bridge/*"
			]
		}
	},
	"include": [
		"src/**/*.ts",
		"src/**/*.tsx",
		"tests/site/**/*.ts",
		"vite.config.ts",
		"playwright.config.ts"
	]
}
